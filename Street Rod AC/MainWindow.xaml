<Window x:Class="Street_Rod_AC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Street_Rod_AC"
        mc:Ignorable="d"
        Title="Street Rod AC"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Background="Transparent">
    <!-- Root Grid -->
    <Grid>
        <!-- Main Menu Grid with Background -->
        <Grid x:Name="MainMenuGrid"
              Background="{StaticResource MainBackgroundBrush}"
              Opacity="0">

        <!-- Exit Button -->
        <Button x:Name="ExitButton"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource ExitButtonBrush}"
                Command="{Binding ExitCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0">
            <Button.RenderTransform>
                <TranslateTransform Y="30"/>
            </Button.RenderTransform>
        </Button>

        <!-- Menu Buttons Container -->
        <StackPanel x:Name="MenuButtonsContainer"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="30"/>
            </StackPanel.RenderTransform>

            <!-- Load Game Button -->
            <Button Style="{StaticResource MenuButtonStyle}"
                    Background="{StaticResource LoadGameButtonBrush}"
                    Command="{Binding LoadGameCommand}"
                    Margin="0,0,100,0"/>

            <!-- New Game Button -->
            <Button Style="{StaticResource MenuButtonStyle}"
                    Background="{StaticResource NewGameButtonBrush}"
                    Command="{Binding NewGameCommand}"/>
        </StackPanel>
        </Grid>

        <!-- Splash Screen Overlay -->
        <Grid x:Name="SplashScreen"
              Background="{StaticResource InitBackgroundBrush}"
              Panel.ZIndex="1"
              MouseDown="SplashScreen_MouseDown">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Background fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           Duration="0:0:1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <!-- Logo Text Image -->
            <Image x:Name="LogoText"
                   Source="pack://application:,,,/Assets/Images/Text/street_rod_powered_by_ac.png"
                   Width="800"
                   Stretch="Uniform"
                   Opacity="0">
                <Image.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- Logo text fade in after background -->
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="0.0"
                                               To="1.0"
                                               BeginTime="0:0:1"
                                               Duration="0:0:1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
        </Grid>
    </Grid>
</Window>
