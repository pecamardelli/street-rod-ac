<Window x:Class="Street_Rod_AC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Street_Rod_AC"
        mc:Ignorable="d"
        Title="Street Rod AC"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Background="Transparent">
    <!-- Main Menu Grid with Background -->
    <Grid Background="{StaticResource MainBackgroundBrush}">
        <!-- Menu Buttons Container -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           Duration="0:0:1.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <!-- New Game Button -->
            <Button Style="{StaticResource MenuButtonStyle}"
                    Background="{StaticResource NewGameButtonBrush}"
                    Command="{Binding NewGameCommand}"
                    Margin="0,0,0,20"/>

            <!-- Load Game Button -->
            <Button Style="{StaticResource MenuButtonStyle}"
                    Background="{StaticResource LoadGameButtonBrush}"
                    Command="{Binding LoadGameCommand}"/>
        </StackPanel>
    </Grid>
</Window>
