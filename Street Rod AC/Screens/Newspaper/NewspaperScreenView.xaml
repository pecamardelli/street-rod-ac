<UserControl x:Class="Street_Rod_AC.Screens.Newspaper.NewspaperScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bottomBar="clr-namespace:Street_Rod_AC.Components.BottomBar"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="RootGrid"
          Background="{StaticResource NewspaperBackgroundBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0"/>


        <!-- Content Area: the paper's race pages, the invitations, the classifieds -->
        <Grid Grid.Row="0" Margin="20,80,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- The race pages (Left Side): what the street did the last few days -->
            <Border x:Name="NewsPanel"
                    Grid.Column="0"
                    Background="{StaticResource BgDarkDFBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    Margin="0,0,20,0"
                    Opacity="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="STREET NEWS"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding EditionDisplay}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="A quiet few days on the street. Nothing worth printing."
                               FontSize="{StaticResource FontSizeSmall}"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="15"
                               Visibility="{Binding HasArticles, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Articles}" Margin="15,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,0,0,12"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Headline}"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextPrimaryBrush}">
                                                <!-- The lead story in bigger type -->
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLead}" Value="True">
                                                                <Setter Property="FontSize" Value="{StaticResource FontSizeTitleSmall}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DateDisplay}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource GoldBrush}"
                                                       Margin="0,2,0,4"/>
                                            <TextBlock Text="{Binding Body}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Race Invitations Panel (Middle) -->
            <Border x:Name="RaceInvitationsPanel"
                    Grid.Column="1"
                    Background="{StaticResource BgDarkDFBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    Margin="0,0,20,0"
                    Opacity="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="15">
                        <TextBlock Text="RACE INVITATIONS"
                                   FontSize="{StaticResource FontSizeHeading}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Text="Nobody is putting on a race right now. Check back in a day or two."
                               FontSize="{StaticResource FontSizeSmall}"
                               FontStyle="Italic"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="15"
                               Visibility="{Binding HasRaceInvitations, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- Events List -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RaceInvitations}"
                                      Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Event Card -->
                                    <Border Background="{StaticResource BgMediumBrush}"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            Opacity="{Binding Opacity}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <!-- Event name and type -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="Bold"
                                                               FontSize="{StaticResource FontSizeSubheading}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Background="{StaticResource BorderLightBrush}"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RaceTypeDisplay}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Description -->
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>

                                                <!-- Requirements -->
                                                <TextBlock Margin="0,6,0,0">
                                                    <Run Text="Requirements: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                                                    <Run Text="{Binding RequirementsDescription, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                                                </TextBlock>

                                                <!-- Reward -->
                                                <TextBlock Margin="0,2,0,0">
                                                    <Run Text="Reward: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                                                    <Run Text="{Binding RewardDescription, Mode=OneWay}" Foreground="{StaticResource AccentSuccessBrush}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold"/>
                                                </TextBlock>

                                                <!-- Pink Slip Warning -->
                                                <TextBlock Text="{Binding PinkSlipWarning}"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding ShowPinkSlipWarning, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                <!-- Footer: Expiry and Eligibility -->
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding ExpiresInText}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontStyle="Italic">
                                                        <!-- Orange, red when it expires within a day -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text=" | "
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding EligibilityText}"
                                                               FontSize="{StaticResource FontSizeCaption}"
                                                               FontStyle="Italic">
                                                        <!-- Green when a car can enter, red when none can -->
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasEligibleCars}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentSuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Enter button -->
                                            <Button Grid.Column="1"
                                                    Content="ENTER"
                                                    Command="{Binding DataContext.EnterEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanEnter}"
                                                    VerticalAlignment="Center"
                                                    Margin="15,0,0,0"
                                                    Padding="15,10"
                                                    FontSize="{StaticResource FontSizeSmall}"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource BgPanelBrush}"
                                                    Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="{StaticResource AccentSuccessBrush}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd"
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="4"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessHoverBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray50Brush}"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource Gray80Brush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- The classifieds (Right Side): the market buttons, then the player's own ads, scrolled when they run long -->
            <Grid x:Name="ContentPanel"
                  Grid.Column="2"
                  Opacity="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The two market buttons side by side, at two thirds of their size -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="0.66" ScaleY="0.66"/>
                    </StackPanel.LayoutTransform>

                    <!-- Used Parts Button -->
                    <Button Style="{StaticResource GameButtonStyle}"
                            Background="{StaticResource UsedPartsButtonBrush}"
                            Command="{Binding UsedPartsCommand}"
                            Tag="Browse used parts"
                            Margin="0,0,20,0"/>

                    <!-- Used Cars Button -->
                    <Button Style="{StaticResource GameButtonStyle}"
                            Background="{StaticResource UsedCarsButtonBrush}"
                            Command="{Binding UsedCarsCommand}"
                            Tag="Browse used cars"/>
                </StackPanel>

                <!-- The player's own cars in the paper, and the buyers who called -->
                <Border Grid.Row="1"
                        Background="{StaticResource BgPanelCCBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="15,10"
                        Margin="0,20,0,0"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasPlayerAds, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Your Ads"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PlayerAds}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeSmall}">
                                                        <Run Text="{Binding CarName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AskingDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding OfferDisplay}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Take It"
                                                        Command="{Binding AcceptCommand}"
                                                        Style="{StaticResource DialogPrimaryButtonStyle}"
                                                        Width="80"
                                                        Height="28"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding HasOffer, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Grid.Column="2"
                                                        Content="Turn Down"
                                                        Command="{Binding DeclineCommand}"
                                                        Style="{StaticResource DialogSecondaryButtonStyle}"
                                                        Width="80"
                                                        Height="28"
                                                        Margin="6,0,0,0"
                                                        Visibility="{Binding HasOffer, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Nav Bar -->
        <bottomBar:BottomBarView Grid.Row="1"
                                 BankrollDisplay="{Binding BankrollDisplay}"/>
    </Grid>
</UserControl>
