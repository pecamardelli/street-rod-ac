<UserControl x:Class="Street_Rod_AC.Screens.Newspaper.NewspaperScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:bottomBar="clr-namespace:Street_Rod_AC.Components.BottomBar"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="RootGrid"
          Background="{StaticResource NewspaperBackgroundBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0"/>


        <!-- Content: Market Buttons -->
        <StackPanel x:Name="ContentPanel"
                    Grid.Row="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0">
            <!-- Row: Used Parts and Used Cars Buttons -->
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center">
                <!-- Used Parts Button -->
                <Button Style="{StaticResource GameButtonStyle}"
                        Background="{StaticResource UsedPartsButtonBrush}"
                        Command="{Binding UsedPartsCommand}"
                        Tag="Browse used parts"
                        Margin="0,0,50,0"/>

                <!-- Used Cars Button -->
                <Button Style="{StaticResource GameButtonStyle}"
                        Background="{StaticResource UsedCarsButtonBrush}"
                        Command="{Binding UsedCarsCommand}"
                        Tag="Browse used cars"/>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Nav Bar -->
        <bottomBar:BottomBarView Grid.Row="1"
                                 BankrollDisplay="{Binding BankrollDisplay}"/>
    </Grid>
</UserControl>
