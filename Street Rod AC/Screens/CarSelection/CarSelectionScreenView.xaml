<UserControl x:Class="Street_Rod_AC.Screens.CarSelection.CarSelectionScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource MainBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Garage Button -->
        <Button x:Name="GarageButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource GarageIconButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- Main Content -->
        <Grid Grid.Row="0" Margin="0,100,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                      Text="SELECT YOUR CAR"
                      FontSize="{StaticResource FontSizeScreenTitle}"
                      FontWeight="Bold"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,30"/>

            <!-- Scrollable Car List -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Cars}"
                             HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Car Card Button -->
                            <Button Command="{Binding DataContext.SelectCarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}"
                                   Background="Transparent"
                                   BorderThickness="0"
                                   Padding="0"
                                   Margin="0,0,0,20"
                                   HorizontalContentAlignment="Stretch"
                                   Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CardBorder"
                                                           Background="{StaticResource BgMediumBrush}"
                                                           BorderBrush="{StaticResource BorderLightBrush}"
                                                           BorderThickness="2"
                                                           CornerRadius="10"
                                                           Width="800"
                                                           Height="200">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black"
                                                                            Direction="270"
                                                                            ShadowDepth="3"
                                                                            BlurRadius="10"
                                                                            Opacity="0.5"/>
                                                        </Border.Effect>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="350"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Preview Image -->
                                                            <Border Grid.Column="0"
                                                                   Background="{StaticResource BgPanelBrush}"
                                                                   CornerRadius="10,0,0,10"
                                                                   Margin="0"
                                                                   ClipToBounds="True">
                                                                <Grid>
                                                                    <!-- Car Preview Image -->
                                                                    <Image Source="{Binding PreviewImagePath}"
                                                                          Stretch="Uniform"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Visibility="{Binding HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                                                    <!-- Placeholder when no image -->
                                                                    <StackPanel VerticalAlignment="Center"
                                                                               HorizontalAlignment="Center"
                                                                               Visibility="{Binding HasPreviewImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="NO PREVIEW"
                                                                                  FontSize="{StaticResource FontSizeSubheading}"
                                                                                  FontWeight="Bold"
                                                                                  Foreground="{StaticResource BorderLightBrush}"
                                                                                  HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Car Details -->
                                                            <StackPanel Grid.Column="1"
                                                                       VerticalAlignment="Center"
                                                                       Margin="30,20,20,20">
                                                                <!-- Car Name -->
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                          FontSize="{StaticResource FontSizeTitleSmall}"
                                                                          FontWeight="Bold"
                                                                          Foreground="{StaticResource TextPrimaryBrush}"
                                                                          Margin="0,0,0,5"/>

                                                                <!-- Year -->
                                                                <TextBlock Text="{Binding YearDisplay}"
                                                                          FontSize="{StaticResource FontSizeHeading}"
                                                                          Foreground="{StaticResource TextSecondaryBrush}"
                                                                          Margin="0,0,0,20"/>

                                                                <!-- Stats -->
                                                                <StackPanel Orientation="Vertical">
                                                                    <TextBlock Text="{Binding ConditionDisplay}"
                                                                              FontSize="{StaticResource FontSizeBody}"
                                                                              Foreground="{StaticResource TextPrimaryBrush}"
                                                                              Margin="0,0,0,5"/>
                                                                    <TextBlock Text="{Binding MileageDisplay}"
                                                                              FontSize="{StaticResource FontSizeBody}"
                                                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                </StackPanel>

                                                                <!-- Selected Indicator -->
                                                                <Border Background="{StaticResource AccentSuccessBrush}"
                                                                       CornerRadius="3"
                                                                       Padding="10,5"
                                                                       HorizontalAlignment="Left"
                                                                       Margin="0,15,0,0"
                                                                       Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="CURRENTLY SELECTED"
                                                                              FontSize="{StaticResource FontSizeSmall}"
                                                                              FontWeight="Bold"
                                                                              Foreground="{StaticResource BgPanelBrush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource TextDisabledBrush}"/>
                                                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource Gray33Brush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource Gray80Brush}"/>
                                                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource BgLightBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Nav Bar -->
        <Border Grid.Row="1"
                Background="{StaticResource BorderLightBrush}"
                BorderBrush="{StaticResource Gray30Brush}"
                BorderThickness="0,1,0,0"
                Height="40">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bankroll Display -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <TextBlock Text="Bankroll:"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="{StaticResource FontSizeSubheading}"
                              FontWeight="Bold"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BankrollDisplay}"
                              Foreground="{StaticResource AccentSuccessBrush}"
                              FontSize="{StaticResource FontSizeSubheading}"
                              FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
