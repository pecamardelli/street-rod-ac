<UserControl x:Class="Street_Rod_AC.Screens.LoadGame.LoadGameScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="800">
    <!-- The Load Game card of the main screen: the saved careers, a click away from their garage -->
    <Border Style="{StaticResource MenuCardStyle}">
        <StackPanel>
            <TextBlock Text="LOAD GAME" Style="{StaticResource MenuCardTitleStyle}"/>

            <!-- Save Games List -->
            <Border Background="#80000000"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Width="620"
                    MinHeight="120"
                    MaxHeight="400">
                <Grid>
                    <!-- No Saves Message -->
                    <TextBlock Text="No saved games found"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSaves, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- Saves List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasSaves, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding SavedGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgLightBrush}"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,10"
                                        Padding="15"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                     Command="{Binding DataContext.LoadSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BgDarkBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <!-- Player Name -->
                                            <TextBlock Text="{Binding PlayerName}"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      FontSize="{StaticResource FontSizeHeadingLarge}"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,5"/>

                                            <!-- Save Name -->
                                            <TextBlock Text="{Binding SaveName}"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      FontSize="{StaticResource FontSizeBody}"
                                                      Margin="0,0,0,5"/>

                                            <!-- Last Played -->
                                            <TextBlock Text="{Binding LastPlayedText}"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      FontSize="{StaticResource FontSizeSmall}"/>
                                        </StackPanel>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="1"
                                               Content="Delete"
                                               Style="{StaticResource DialogSecondaryButtonStyle}"
                                               Width="80"
                                               Height="35"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Command="{Binding DataContext.DeleteSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </Border>

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource AccentPrimaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <Button Content="Back"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Width="150"
                    Height="45"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    FontSize="{StaticResource FontSizeSubheading}"/>
        </StackPanel>
    </Border>
</UserControl>
