<UserControl x:Class="Street_Rod_AC.Screens.LoadGame.LoadGameScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource MainBackgroundBrush}"
          Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Background fade in -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.0"
                                       To="1.0"
                                       Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0">
            <Button.RenderTransform>
                <TranslateTransform Y="30"/>
            </Button.RenderTransform>
            <Button.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                            <!-- Slide up -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           From="30"
                                           To="0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <!-- Content Container -->
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0"
                    MaxWidth="800">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="30"/>
            </StackPanel.RenderTransform>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                            <!-- Slide up -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           From="30"
                                           To="0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <!-- Title -->
            <TextBlock Text="Load Game"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Save Games List -->
            <Border Background="{StaticResource BgMediumBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="20"
                    MinWidth="600"
                    MaxHeight="400">
                <Grid>
                    <!-- No Saves Message -->
                    <TextBlock Text="No saved games found"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSaves, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                    <!-- Saves List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasSaves, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding SavedGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgLightBrush}"
                                        BorderBrush="{StaticResource BorderDarkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,10"
                                        Padding="15"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                     Command="{Binding DataContext.LoadSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BgDarkBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <!-- Player Name -->
                                            <TextBlock Text="{Binding PlayerName}"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      FontSize="20"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,5"/>

                                            <!-- Save Name -->
                                            <TextBlock Text="{Binding SaveName}"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      FontSize="14"
                                                      Margin="0,0,0,5"/>

                                            <!-- Last Played -->
                                            <TextBlock Text="{Binding LastPlayedText}"
                                                      Foreground="{StaticResource TextSecondaryBrush}"
                                                      FontSize="12"/>
                                        </StackPanel>

                                        <!-- Delete Button -->
                                        <Button Grid.Column="1"
                                               Content="Delete"
                                               Style="{StaticResource DialogSecondaryButtonStyle}"
                                               Width="80"
                                               Height="35"
                                               FontSize="12"
                                               Command="{Binding DataContext.DeleteSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </Border>

            <!-- Error Message -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource AccentPrimaryBrush}"
                       FontSize="14"
                       TextAlignment="Center"
                       Margin="0,20,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
