<UserControl x:Class="Street_Rod_AC.Screens.DealerMap.DealerMapScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:Street_Rod_AC.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- The map and its pins share one rectangle of a fixed shape, so a pin stays on its bit of the
             city whatever the window does. Whatever is left over is board around it. -->
        <helpers:AspectPanel Aspect="{Binding MapAspect}" Margin="0,86,0,0">

            <!-- The basin, cropped out of the full map. MapViewbox is the window onto it -->
            <Rectangle>
                <Rectangle.Fill>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/Images/Backgrounds/los_angeles_map.jpg"
                                Viewbox="{Binding MapViewbox}"
                                ViewboxUnits="RelativeToBoundingBox"
                                Stretch="Fill"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- A modern street map read as old paper: warmed and quietened so the print stops competing
                 with the pins -->
            <Rectangle Opacity="0.30">
                <Rectangle.Fill>
                    <SolidColorBrush Color="#6B4A1E"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.75" RadiusY="0.8">
                        <GradientStop Color="#00000000" Offset="0.5"/>
                        <GradientStop Color="#88000000" Offset="1.0"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Pins, each held at its own spot on the map -->
            <ItemsControl ItemsSource="{Binding Pins}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <helpers:FractionPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="helpers:FractionPanel.X" Value="{Binding X}"/>
                        <Setter Property="helpers:FractionPanel.Y" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- The pin is the button; the card is its tooltip -->
                        <Button Command="{Binding DataContext.VisitDealerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel x:Name="Root" Orientation="Vertical" HorizontalAlignment="Center">
                                        <Border x:Name="Dot"
                                                Width="18" Height="18"
                                                CornerRadius="9"
                                                Background="{StaticResource AccentPrimaryBrush}"
                                                BorderBrush="#F5E6C8"
                                                BorderThickness="2"
                                                HorizontalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="0.85"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="Plate"
                                                Margin="0,5,0,0"
                                                Background="#D0121212"
                                                BorderBrush="#70F5E6C8"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="8,3,8,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding StockDisplay}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                            <Setter TargetName="Dot" Property="Width" Value="22"/>
                                            <Setter TargetName="Dot" Property="Height" Value="22"/>
                                            <Setter TargetName="Dot" Property="CornerRadius" Value="11"/>
                                            <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ToolTip>
                                <ToolTip Background="#F21A1A1A" BorderBrush="#60F5E6C8" BorderThickness="1" Padding="12">
                                    <StackPanel MaxWidth="260">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Region}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding Blurb}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding PriceDisplay}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource AccentSuccessBrush}"/>
                                        <TextBlock Text="{Binding TravelDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ToolTip>
                            </Button.ToolTip>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </helpers:AspectPanel>

        <!-- Header -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,28,0,0">
            <TextBlock Text="WHERE TO LOOK"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Pick a lot and drive out to see what they have"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Back -->
        <Button Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- What a trip spends: money and daylight -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="#C0121212"
                BorderBrush="#50F5E6C8"
                BorderThickness="1"
                CornerRadius="3"
                Padding="14,8,14,10">
            <StackPanel>
                <TextBlock Text="{Binding BankrollDisplay}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentSuccessBrush}"/>
                <TextBlock Text="{Binding TimeDisplay}"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DateDisplay}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Nothing to show: the definitions file did not load. Drawn under the loading overlay, so the
             first market of a game does not read as an empty map on the way past -->
        <TextBlock Text="No dealers could be found on the map."
                   FontSize="16"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding HasDealers, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

        <!-- The first market of a game takes a few seconds to put together -->
        <Border Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#B0000000">
            <TextBlock Text="The dealers are putting their cars out..."
                       FontSize="18"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
