<UserControl x:Class="Street_Rod_AC.Screens.Garage.GarageScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="RootGrid"
          Background="{StaticResource MainBackgroundBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0"/>

        <!-- Exit Button -->
        <Button x:Name="ExitButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource ExitButtonBrush}"
                Command="{Binding ExitCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,94,0,0"
                Opacity="0"/>

        <!-- Main Content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Center Content (Car Name + Preview) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selected Car Display Bar (Clickable) -->
                <Button x:Name="CarDisplayButton"
                    Grid.Row="0"
                    Command="{Binding SelectCarCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,80,0,20"
                    Cursor="Hand"
                    Opacity="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CarDisplayBorder"
                                           Background="#2A2A2A"
                                           BorderBrush="#404040"
                                           BorderThickness="2"
                                           CornerRadius="5"
                                           Padding="30,15"
                                           Width="800">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black"
                                                            Direction="270"
                                                            ShadowDepth="3"
                                                            BlurRadius="10"
                                                            Opacity="0.5"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding SelectedCarDisplay}"
                                                  FontSize="24"
                                                  FontWeight="Bold"
                                                  Foreground="{StaticResource TextPrimaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CarDisplayBorder" Property="BorderBrush" Value="#606060"/>
                                            <Setter TargetName="CarDisplayBorder" Property="Background" Value="#333333"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CarDisplayBorder" Property="BorderBrush" Value="#808080"/>
                                            <Setter TargetName="CarDisplayBorder" Property="Background" Value="#3A3A3A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Car Preview Container -->
            <Border x:Name="PreviewContainer"
                    Grid.Row="1"
                    Background="#1A1A1A"
                    BorderBrush="#404040"
                    BorderThickness="2"
                    CornerRadius="5"
                    HorizontalAlignment="Center"
                    Width="800"
                    Margin="0,0,0,40"
                    Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                    Direction="270"
                                    ShadowDepth="5"
                                    BlurRadius="15"
                                    Opacity="0.6"/>
                </Border.Effect>

                <Grid>
                    <!-- ==================== CAR PREVIEW PANEL ==================== -->
                    <Grid Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=CarPreview}">
                        <!-- Car Preview Image -->
                        <Image Source="{Binding SelectedCar.PreviewImagePath}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Placeholder when no image -->
                        <StackPanel VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="NO PREVIEW IMAGE"
                                      FontSize="32"
                                      FontWeight="Bold"
                                      Foreground="#404040"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="(preview.jpg not found)"
                                      FontSize="16"
                                      Foreground="#606060"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Car Details Overlay -->
                        <Border Background="#00000088"
                               VerticalAlignment="Bottom"
                               Padding="20,8"
                               Visibility="{Binding HasCars, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Condition -->
                                <TextBlock Grid.Column="0"
                                          Text="Condition:"
                                          FontSize="14"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                          Text="{Binding SelectedCar.ConditionDisplay}"
                                          FontSize="14"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Center"/>

                                <!-- Mileage -->
                                <TextBlock Grid.Column="2"
                                          Text="Mileage:"
                                          FontSize="14"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                          Text="{Binding SelectedCar.MileageDisplay}"
                                          FontSize="14"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Center"/>

                                <!-- Showroom Button -->
                                <Button Grid.Column="4"
                                        Content="Preview in Showroom"
                                        Command="{Binding LaunchShowroomCommand}"
                                        Style="{StaticResource DialogPrimaryButtonStyle}"
                                        Padding="15,5"
                                        FontSize="14"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== CALENDAR PANEL ==================== -->
                    <Grid Visibility="{Binding ActivePanel, Converter={StaticResource GaragePanelToVisibilityConverter}, ConverterParameter=Calendar}"
                          Margin="40">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Month/Year Header -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding CurrentMonthYear}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <!-- Current Time Display -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                            <TextBlock Text="{Binding CurrentDayOfWeek}"
                                       FontSize="18"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,15,0"/>
                            <TextBlock Text="{Binding CurrentTimeDisplay}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Calendar Grid -->
                        <Grid Grid.Row="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Day of Week Headers -->
                            <ItemsControl Grid.Row="0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <TextBlock Text="Sun" Width="70" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5"/>
                                <TextBlock Text="Mon" Width="70" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5"/>
                                <TextBlock Text="Tue" Width="70" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5"/>
                                <TextBlock Text="Wed" Width="70" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5"/>
                                <TextBlock Text="Thu" Width="70" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5"/>
                                <TextBlock Text="Fri" Width="70" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5"/>
                                <TextBlock Text="Sat" Width="70" TextAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="5"/>
                            </ItemsControl>

                            <!-- Days Grid -->
                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="70"
                                                Height="50"
                                                Margin="5"
                                                CornerRadius="5"
                                                BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2A2A2A"/>
                                                    <Setter Property="BorderBrush" Value="#404040"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentDay}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Day}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentDay}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            </Grid>

            <!-- Calendar Button -->
            <Button x:Name="CalendarButton"
                    Grid.Column="2"
                    Command="{Binding ShowCalendarCommand}"
                    Width="128"
                    Height="128"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0"
                    Cursor="Hand"
                    Opacity="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#404040"
                                                BorderThickness="2"
                                                CornerRadius="5">
                                            <Border.Clip>
                                                <RectangleGeometry RadiusX="5" RadiusY="5">
                                                    <RectangleGeometry.Rect>
                                                        <Rect Width="128" Height="128"/>
                                                    </RectangleGeometry.Rect>
                                                </RectangleGeometry>
                                            </Border.Clip>
                                        </Border>
                                        <TextBlock x:Name="hoverLabel"
                                                   Text="Calendar"
                                                   FontFamily="Courier New"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Bottom"
                                                   Margin="0,0,0,10"
                                                   Opacity="0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                                            <Setter TargetName="hoverLabel" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Button.Background>
                    <ImageBrush ImageSource="/Assets/Images/Buttons/calendar.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
        </Grid>

        <!-- Bottom Nav Bar -->
        <Border Grid.Row="1"
                Background="#404040"
                BorderBrush="#303030"
                BorderThickness="0,1,0,0"
                Height="40">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bankroll Display -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <TextBlock Text="Bankroll:"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="16"
                              FontWeight="Bold"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BankrollDisplay}"
                              Foreground="#90EE90"
                              FontSize="16"
                              FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
