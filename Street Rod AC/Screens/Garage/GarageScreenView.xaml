<UserControl x:Class="Street_Rod_AC.Screens.Garage.GarageScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource MainBackgroundBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Background fade in -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.0"
                                       To="1.0"
                                       Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0">
            <Button.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <!-- Main Content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Selected Car Display Bar (Upper Middle Section) -->
            <Border Grid.Row="0"
                    Background="#2A2A2A"
                    BorderBrush="#404040"
                    BorderThickness="2"
                    CornerRadius="5"
                    Margin="0,80,0,20"
                    HorizontalAlignment="Center"
                    Padding="30,15"
                    Width="800"
                    Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                    Direction="270"
                                    ShadowDepth="3"
                                    BlurRadius="10"
                                    Opacity="0.5"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="0.0"
                                               To="1.0"
                                               BeginTime="0:0:0.3"
                                               Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <TextBlock Text="{Binding SelectedCarDisplay}"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <!-- Car Preview Container -->
            <Border Grid.Row="1"
                    Background="#1A1A1A"
                    BorderBrush="#404040"
                    BorderThickness="2"
                    CornerRadius="5"
                    HorizontalAlignment="Center"
                    Width="800"
                    Margin="0,0,0,40"
                    Opacity="0">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                    Direction="270"
                                    ShadowDepth="5"
                                    BlurRadius="15"
                                    Opacity="0.6"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="0.0"
                                               To="1.0"
                                               BeginTime="0:0:0.4"
                                               Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <!-- Car Preview Image -->
                    <Image Source="{Binding SelectedCar.PreviewImagePath}"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Placeholder when no image -->
                    <StackPanel VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding SelectedCar.HasPreviewImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="NO PREVIEW IMAGE"
                                  FontSize="32"
                                  FontWeight="Bold"
                                  Foreground="#404040"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="(preview.jpg not found)"
                                  FontSize="16"
                                  Foreground="#606060"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Car Details Overlay -->
                    <Border Background="#00000088"
                           VerticalAlignment="Bottom"
                           Padding="20"
                           Visibility="{Binding HasCars, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Condition -->
                            <TextBlock Grid.Column="0"
                                      Text="Condition:"
                                      FontSize="14"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                      Text="{Binding SelectedCar.ConditionDisplay}"
                                      FontSize="14"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,20,0"
                                      VerticalAlignment="Center"/>

                            <!-- Mileage -->
                            <TextBlock Grid.Column="2"
                                      Text="Mileage:"
                                      FontSize="14"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                      Text="{Binding SelectedCar.MileageDisplay}"
                                      FontSize="14"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      Margin="0,0,20,0"
                                      VerticalAlignment="Center"/>

                            <!-- Showroom Button -->
                            <Button Grid.Column="4"
                                    Content="Preview in Showroom"
                                    Command="{Binding LaunchShowroomCommand}"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    Padding="15,8"
                                    FontSize="14"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Nav Bar -->
        <Border Grid.Row="1"
                Background="#404040"
                BorderBrush="#303030"
                BorderThickness="0,1,0,0"
                Height="40">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bankroll Display -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <TextBlock Text="Bankroll:"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="16"
                              FontWeight="Bold"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BankrollDisplay}"
                              Foreground="#90EE90"
                              FontSize="16"
                              FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
