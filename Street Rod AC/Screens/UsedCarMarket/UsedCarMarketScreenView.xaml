<UserControl x:Class="Street_Rod_AC.Screens.UsedCarMarket.UsedCarMarketScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource NewspaperBackgroundBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Background fade in -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.0"
                                       To="1.0"
                                       Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0">
            <Button.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <!-- Header -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,30,0,20"
                    Opacity="0">
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <TextBlock Text="USED CAR MARKET"
                      FontSize="32"
                      FontWeight="Bold"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"/>

            <!-- Dealer Filter -->
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center">
                <TextBlock Text="Dealer:"
                          FontSize="16"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding DealerOptions}"
                         SelectedItem="{Binding SelectedDealer}"
                         Width="200"
                         Height="30"
                         FontSize="14"/>
            </StackPanel>
        </StackPanel>

        <!-- Car Listings -->
        <ScrollViewer Grid.Row="1"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Margin="40,120,40,20">
            <ItemsControl ItemsSource="{Binding ListingsView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                  HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2A2A2A"
                               BorderBrush="#404040"
                               BorderThickness="2"
                               CornerRadius="5"
                               Margin="10"
                               Width="350"
                               Height="220">
                            <Border.Effect>
                                <DropShadowEffect Color="Black"
                                                Direction="270"
                                                ShadowDepth="3"
                                                BlurRadius="10"
                                                Opacity="0.5"/>
                            </Border.Effect>

                            <Grid Margin="15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Car Name -->
                                <TextBlock Grid.Row="0"
                                          Text="{Binding DisplayName}"
                                          FontSize="20"
                                          FontWeight="Bold"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          TextWrapping="Wrap"
                                          Margin="0,0,0,5"/>

                                <!-- Year & Dealer -->
                                <StackPanel Grid.Row="1"
                                          Orientation="Horizontal"
                                          Margin="0,0,0,10">
                                    <TextBlock Text="{Binding YearDisplay}"
                                              FontSize="14"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding DealerName}"
                                              FontSize="14"
                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Car Details -->
                                <StackPanel Grid.Row="2"
                                          Margin="0,0,0,10">
                                    <!-- Price -->
                                    <StackPanel Orientation="Horizontal"
                                              Margin="0,0,0,5">
                                        <TextBlock Text="Price:"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  Width="80"/>
                                        <TextBlock Text="{Binding PriceDisplay}"
                                                  FontSize="14"
                                                  FontWeight="Bold"
                                                  Foreground="#90EE90"/>
                                    </StackPanel>

                                    <!-- Condition -->
                                    <StackPanel Orientation="Horizontal"
                                              Margin="0,0,0,5">
                                        <TextBlock Text="Condition:"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  Width="80"/>
                                        <TextBlock Text="{Binding ConditionDisplay}"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- Mileage -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Mileage:"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  Width="80"/>
                                        <TextBlock Text="{Binding MileageDisplay}"
                                                  FontSize="14"
                                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Purchase Button -->
                                <Button Grid.Row="3"
                                       Content="Purchase"
                                       Command="{Binding DataContext.PurchaseCarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}"
                                       Height="35"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Background="{StaticResource AccentPrimaryBrush}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       BorderBrush="{StaticResource BorderDarkBrush}"
                                       BorderThickness="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                               BorderBrush="{TemplateBinding BorderBrush}"
                                                               BorderThickness="{TemplateBinding BorderThickness}"
                                                               CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanAfford}" Value="False">
                                                    <Setter Property="Background" Value="#505050"/>
                                                    <Setter Property="Foreground" Value="#808080"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Nav Bar -->
        <Border Grid.Row="2"
                Background="#404040"
                BorderBrush="#303030"
                BorderThickness="0,1,0,0"
                Height="40">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bankroll Display -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <TextBlock Text="Bankroll:"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="16"
                              FontWeight="Bold"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BankrollDisplay}"
                              Foreground="#90EE90"
                              FontSize="16"
                              FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
