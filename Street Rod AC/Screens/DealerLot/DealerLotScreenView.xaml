<UserControl x:Class="Street_Rod_AC.Screens.DealerLot.DealerLotScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Street_Rod_AC.Controls"
             xmlns:helpers="clr-namespace:Street_Rod_AC.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- The lot itself, behind everything -->
        <controls:DealerLotViewport3D x:Name="Viewport"
                                      ShowroomKn5="{Binding ShowroomKn5}"
                                      Cars="{Binding LotCars}"
                                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                      LotRadius="{Binding LotRadius}"
                                      RunningEngine="{Binding Runner, ElementName=EnginePanel}"/>

        <!-- The lot is covered until every car is standing in it, then the cover fades and the viewport
             fades up underneath. Watching an empty room fill a car at a time is not worth showing. -->
        <Grid Background="{StaticResource BgDarkBrush}"
              helpers:Reveal.IsShown="{Binding IsLotReady, ElementName=Viewport, Converter={StaticResource InverseBooleanConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Width="60" Height="60" Margin="0,0,0,26" HorizontalAlignment="Center">
                    <!-- Nothing is coming once the viewport has failed; a spinner over that message would promise otherwise -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" CenterX="30" CenterY="30"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360"
                                                     Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Ellipse Stroke="{StaticResource SpinnerOrangeBrush}" StrokeThickness="4"
                             StrokeDashArray="3 2"
                             Fill="Transparent"/>
                </Border>
                <TextBlock FontSize="{StaticResource FontSizeTitleSmall}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Loading dealer..."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                    <Setter Property="Text" Value="The lot could not be shown in 3D."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,26,0,0"
                    IsHitTestVisible="False">
            <TextBlock Text="{Binding DealerName}"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding StockSummary}"
                       FontSize="{StaticResource FontSizeCompact}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Back to the map -->
        <Button Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- Bankroll -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="{StaticResource Glass12C0Brush}"
                BorderBrush="{StaticResource Cream50Brush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="14,8,14,10">
            <StackPanel>
                <TextBlock Text="{Binding BankrollDisplay}"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentSuccessBrush}"/>
                <TextBlock Text="{Binding TimeDisplay}"
                           FontSize="{StaticResource FontSizeBody}"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding DateDisplay}"
                           FontSize="{StaticResource FontSizeCaption}"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- The card for the car being looked at -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="340"
                Margin="0,0,24,0"
                Background="{StaticResource Glass15E8Brush}"
                BorderBrush="{StaticResource Cream70Brush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel DataContext="{Binding SelectedCar}">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="{StaticResource FontSizeCardTitle}"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding YearDisplay}"
                           FontSize="{StaticResource FontSizeCompact}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,14"/>

                <TextBlock Text="{Binding PriceDisplay}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentSuccessBrush}"
                           Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Condition" Grid.Column="0" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ConditionDisplay}" Grid.Column="1" FontSize="{StaticResource FontSizeCompact}" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mileage" Grid.Column="0" FontSize="{StaticResource FontSizeCompact}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MileageDisplay}" Grid.Column="1" FontSize="{StaticResource FontSizeCompact}" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>

                <TextBlock Text="{Binding EngineDisplay}"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0"
                           Visibility="{Binding EngineDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Who had it, how it has raced -->
                <TextBlock Text="{Binding HistoryDisplay}"
                           FontSize="{StaticResource FontSizeCompact}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0"
                           Visibility="{Binding HistoryDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Start it up before you buy it -->
                <controls:EnginePanel x:Name="EnginePanel"
                                      Margin="0,16,0,0"
                                      Engine="{Binding DataContext.SelectedEngine, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <Button Content="BUY IT"
                        Margin="0,20,0,0"
                        Height="42"
                        FontSize="{StaticResource FontSizeBodyLarge}"
                        FontWeight="Bold"
                        Command="{Binding DataContext.PurchaseCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>

                <Button Content="Back to the lot"
                        Margin="0,10,0,0"
                        Height="32"
                        FontSize="{StaticResource FontSizeCompact}"
                        Background="Transparent"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Command="{Binding DataContext.BackToLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
