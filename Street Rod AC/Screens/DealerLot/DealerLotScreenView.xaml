<UserControl x:Class="Street_Rod_AC.Screens.DealerLot.DealerLotScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Street_Rod_AC.Controls"
             xmlns:helpers="clr-namespace:Street_Rod_AC.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{StaticResource BgDarkBrush}">

        <!-- The lot itself, behind everything -->
        <controls:DealerLotViewport3D x:Name="Viewport"
                                      ShowroomKn5="{Binding ShowroomKn5}"
                                      Cars="{Binding LotCars}"
                                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                      LotRadius="{Binding LotRadius}"
/>

        <!-- The lot is covered until every car is standing in it, then the cover fades and the viewport
             fades up underneath. Watching an empty room fill a car at a time is not worth showing. -->
        <Grid Background="{StaticResource BgDarkBrush}"
              helpers:Reveal.IsShown="{Binding IsLotReady, ElementName=Viewport, Converter={StaticResource InverseBooleanConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontSize="19"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Pulling onto the lot..."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed, ElementName=Viewport}" Value="True">
                                    <Setter Property="Text" Value="The lot could not be shown in 3D."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="13"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} of {1} cars out">
                            <Binding Path="LoadedCount" ElementName="Viewport"/>
                            <Binding Path="ExpectedCount" ElementName="Viewport"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Header -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,26,0,0"
                    IsHitTestVisible="False">
            <TextBlock Text="{Binding DealerName}"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding StockSummary}"
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Back to the map -->
        <Button Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"/>

        <!-- Bankroll -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Background="#C0121212"
                BorderBrush="#50F5E6C8"
                BorderThickness="1"
                CornerRadius="3"
                Padding="14,8,14,8">
            <TextBlock Text="{Binding BankrollDisplay}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentSuccessBrush}"/>
        </Border>

        <!-- The card for the car being looked at -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="340"
                Margin="0,0,24,0"
                Background="#E8151515"
                BorderBrush="#70F5E6C8"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.8"/>
            </Border.Effect>
            <StackPanel DataContext="{Binding SelectedCar}">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="21"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding YearDisplay}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,14"/>

                <TextBlock Text="{Binding PriceDisplay}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentSuccessBrush}"
                           Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Condition" Grid.Column="0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ConditionDisplay}" Grid.Column="1" FontSize="13" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mileage" Grid.Column="0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MileageDisplay}" Grid.Column="1" FontSize="13" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>

                <TextBlock Text="{Binding EngineDisplay}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,8,0,0"
                           Visibility="{Binding EngineDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Button Content="BUY IT"
                        Margin="0,20,0,0"
                        Height="42"
                        FontSize="15"
                        FontWeight="Bold"
                        Command="{Binding DataContext.PurchaseCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>

                <Button Content="Back to the lot"
                        Margin="0,10,0,0"
                        Height="32"
                        FontSize="13"
                        Background="Transparent"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Command="{Binding DataContext.BackToLotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
        </Border>

        <!-- Everything the dealer has, along the bottom. A lot is stocked to what its room holds, so these
             are the same cars that are standing outside; clicking one walks the camera over to it. -->
        <Border VerticalAlignment="Bottom"
                Background="#C0101010"
                BorderBrush="#40F5E6C8"
                BorderThickness="0,1,0,0"
                Padding="16,8,16,12">
            <StackPanel>
                <TextBlock Text="ON THE LOT"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="2,0,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Stock}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,10,0"
                                    Width="168"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Stretch"
                                    Background="#D01E1E1E"
                                    BorderThickness="1"
                                    Padding="10,8,10,8"
                                    Command="{Binding DataContext.SelectCarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                        <Binding/>
                                                        <Binding Path="DataContext.SelectedCar"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                                <Setter Property="Background" Value="#F02A2A2A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding PriceDisplay}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentSuccessBrush}"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding ConditionDisplay}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
