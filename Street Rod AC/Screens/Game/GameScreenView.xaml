<UserControl x:Class="Street_Rod_AC.Screens.Game.GameScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{StaticResource MainBackgroundBrush}"
          Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Background fade in -->
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.0"
                                       To="1.0"
                                       Duration="0:0:0.5"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <!-- Back Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Style="{StaticResource ExitButtonStyle}"
                Background="{StaticResource BackButtonBrush}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Opacity="0">
            <Button.RenderTransform>
                <TranslateTransform Y="30"/>
            </Button.RenderTransform>
            <Button.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                            <!-- Slide up -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           From="30"
                                           To="0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <!-- Game Buttons Container -->
        <StackPanel x:Name="GameButtonsContainer"
                    Grid.Row="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="30"/>
            </StackPanel.RenderTransform>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <!-- Fade in -->
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                           From="0.0"
                                           To="1.0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                            <!-- Slide up -->
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                           From="30"
                                           To="0"
                                           BeginTime="0:0:0.3"
                                           Duration="0:0:0.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <!-- First Row: Newspaper and Garage Buttons -->
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20">
                <!-- Newspaper Button -->
                <Button Style="{StaticResource GameButtonStyle}"
                        Background="{StaticResource NewspaperButtonBrush}"
                        Tag="Newspaper"
                        Margin="0,0,100,0"/>

                <!-- Garage Button -->
                <Button Style="{StaticResource GameButtonStyle}"
                        Background="{StaticResource GarageButtonBrush}"
                        Tag="Go to garage"/>
            </StackPanel>

            <!-- Second Row: Garage Button -->
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Center">
                <!-- Garage Button -->
                <Button Style="{StaticResource GameButtonStyle}"
                        Background="{StaticResource GarageButtonBrush}"
                        Tag="Hit the streets"/>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Nav Bar -->
        <Border Grid.Row="1"
                Background="#404040"
                BorderBrush="#303030"
                BorderThickness="0,1,0,0"
                Height="40">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bankroll Display -->
                <StackPanel Grid.Column="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <TextBlock Text="Bankroll:"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="16"
                              FontWeight="Bold"
                              Margin="0,0,10,9"/>
                    <TextBlock Text="{Binding BankrollDisplay}"
                              Foreground="#90EE90"
                              FontSize="16"
                              FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
