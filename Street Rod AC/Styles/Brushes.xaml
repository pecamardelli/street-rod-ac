<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Merge Colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
    <SolidColorBrush x:Key="BgMediumBrush" Color="{StaticResource BgMedium}"/>
    <SolidColorBrush x:Key="BgLightBrush" Color="{StaticResource BgLight}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}"/>
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccess}"/>

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDark}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>

    <!-- License Input Brushes -->
    <SolidColorBrush x:Key="LicenseBrownBrush" Color="{StaticResource LicenseBrown}"/>

    <!-- Background Images -->
    <ImageBrush x:Key="MainBackgroundBrush"
                ImageSource="pack://application:,,,/Assets/Images/Backgrounds/main.png"
                Stretch="UniformToFill"/>

    <ImageBrush x:Key="InitBackgroundBrush"
                ImageSource="pack://application:,,,/Assets/Images/Backgrounds/init.png"
                Stretch="UniformToFill"/>

    <ImageBrush x:Key="NewspaperBackgroundBrush"
                ImageSource="pack://application:,,,/Assets/Images/Backgrounds/newspaper_background.png"
                Stretch="UniformToFill"/>

    <ImageBrush x:Key="DinerBackgroundBrush"
                ImageSource="pack://application:,,,/Assets/Images/Backgrounds/diner_background.png"
                Stretch="UniformToFill"/>

    <!-- Button Images -->
    <ImageBrush x:Key="NewGameButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/new_game.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="LoadGameButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/load_game.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="ExitButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/exit.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="BackButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/back.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="NewspaperButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/newspaper.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="GarageButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/garage.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="GarageIconButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/garage_icon.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="HitTheStreetsButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/hit_the_streets.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="UsedCarsButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/used_cars.png"
                Stretch="Fill"/>

    <ImageBrush x:Key="UsedPartsButtonBrush"
                ImageSource="pack://application:,,,/Assets/Images/Buttons/used_parts.png"
                Stretch="Fill"/>

    <!-- Text Images -->
    <ImageBrush x:Key="StreetRodLogoTextBrush"
                ImageSource="pack://application:,,,/Assets/Images/Text/street_rod_powered_by_ac.png"
                Stretch="Uniform"/>

</ResourceDictionary>
