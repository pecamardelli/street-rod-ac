<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="PresentationOptions">

    <!-- Merge Colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDark}"/>
    <SolidColorBrush x:Key="BgMediumBrush" Color="{StaticResource BgMedium}"/>
    <SolidColorBrush x:Key="BgLightBrush" Color="{StaticResource BgLight}"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}"/>
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccess}"/>

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDark}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}"/>

    <!-- License Input Brushes -->
    <SolidColorBrush x:Key="LicenseBrownBrush" Color="{StaticResource LicenseBrown}"/>

    <!-- Panel and neutral grey brushes -->
    <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}"/>
    <SolidColorBrush x:Key="Gray26Brush" Color="{StaticResource Gray26}"/>
    <SolidColorBrush x:Key="Gray30Brush" Color="{StaticResource Gray30}"/>
    <SolidColorBrush x:Key="Gray33Brush" Color="{StaticResource Gray33}"/>
    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray70Brush" Color="{StaticResource Gray70}"/>
    <SolidColorBrush x:Key="Gray80Brush" Color="{StaticResource Gray80}"/>
    <SolidColorBrush x:Key="GrayA0Brush" Color="{StaticResource GrayA0}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>

    <!-- Translucent panel brushes -->
    <SolidColorBrush x:Key="BgPanelAABrush" Color="{StaticResource BgPanelAA}"/>
    <SolidColorBrush x:Key="BgPanelCCBrush" Color="{StaticResource BgPanelCC}"/>
    <SolidColorBrush x:Key="BgPanelF2Brush" Color="{StaticResource BgPanelF2}"/>
    <SolidColorBrush x:Key="BgDarkDFBrush" Color="{StaticResource BgDarkDF}"/>
    <SolidColorBrush x:Key="Glass12C0Brush" Color="{StaticResource Glass12C0}"/>
    <SolidColorBrush x:Key="Glass12D0Brush" Color="{StaticResource Glass12D0}"/>
    <SolidColorBrush x:Key="Glass14D0Brush" Color="{StaticResource Glass14D0}"/>
    <SolidColorBrush x:Key="Glass14E0Brush" Color="{StaticResource Glass14E0}"/>
    <SolidColorBrush x:Key="Glass15E8Brush" Color="{StaticResource Glass15E8}"/>

    <!-- Veil brushes (Overlay dims the screen behind a dialog) -->
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource Overlay}"/>
    <SolidColorBrush x:Key="BlackHitTestBrush" Color="{StaticResource BlackHitTest}"/>
    <SolidColorBrush x:Key="BlackB0Brush" Color="{StaticResource BlackB0}"/>
    <SolidColorBrush x:Key="BlackCCBrush" Color="{StaticResource BlackCC}"/>
    <SolidColorBrush x:Key="White20Brush" Color="{StaticResource White20}"/>
    <SolidColorBrush x:Key="White30Brush" Color="{StaticResource White30}"/>
    <SolidColorBrush x:Key="WhiteB0Brush" Color="{StaticResource WhiteB0}"/>

    <!-- Status brushes -->
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
    <SolidColorBrush x:Key="GoldCCBrush" Color="{StaticResource GoldCC}"/>
    <SolidColorBrush x:Key="Gold33Brush" Color="{StaticResource Gold33}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningStrongBrush" Color="{StaticResource WarningStrong}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBg}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <SolidColorBrush x:Key="DangerStrongBrush" Color="{StaticResource DangerStrong}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBg}"/>
    <SolidColorBrush x:Key="SalmonBrush" Color="{StaticResource Salmon}"/>
    <SolidColorBrush x:Key="SuccessStrongBrush" Color="{StaticResource SuccessStrong}"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHover}"/>
    <SolidColorBrush x:Key="FitBrush" Color="{StaticResource Fit}"/>
    <SolidColorBrush x:Key="Fit30Brush" Color="{StaticResource Fit30}"/>
    <SolidColorBrush x:Key="PaleYellowBrush" Color="{StaticResource PaleYellow}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBg}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBg}"/>
    <SolidColorBrush x:Key="GoldBgBrush" Color="{StaticResource GoldBg}"/>
    <SolidColorBrush x:Key="RoyalBlueBrush" Color="{StaticResource RoyalBlue}"/>
    <SolidColorBrush x:Key="SpinnerOrangeBrush" Color="{StaticResource SpinnerOrange}"/>
    <SolidColorBrush x:Key="RedZoneBrush" Color="{StaticResource RedZone}"/>

    <!-- Dealer map and lot brushes -->
    <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource Cream}"/>
    <SolidColorBrush x:Key="Cream50Brush" Color="{StaticResource Cream50}"/>
    <SolidColorBrush x:Key="Cream60Brush" Color="{StaticResource Cream60}"/>
    <SolidColorBrush x:Key="Cream70Brush" Color="{StaticResource Cream70}"/>
    <SolidColorBrush x:Key="MapDotFarBrush" Color="{StaticResource MapDotFar}"/>
    <SolidColorBrush x:Key="MapDotFarBorderBrush" Color="{StaticResource MapDotFarBorder}"/>
    <SolidColorBrush x:Key="MapFarTextBrush" Color="{StaticResource MapFarText}"/>

    <!-- Background Images.
         The art is 2560x1440 (about 15 MB each once decoded, kept alive in the application resources after first
         use); decoding at 1920 wide cuts that to about 8 MB with no visible change at the size the screens draw it.
         OnLoad reads the file once and lets the stream go; frozen, so WPF can share them without change tracking -->
    <BitmapImage x:Key="MainBackgroundImage"
                 UriSource="pack://application:,,,/Assets/Images/Backgrounds/main.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="MainBackgroundBrush"
                ImageSource="{StaticResource MainBackgroundImage}"
                Stretch="UniformToFill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="InitBackgroundImage"
                 UriSource="pack://application:,,,/Assets/Images/Backgrounds/init.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="InitBackgroundBrush"
                ImageSource="{StaticResource InitBackgroundImage}"
                Stretch="UniformToFill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="NewspaperBackgroundImage"
                 UriSource="pack://application:,,,/Assets/Images/Backgrounds/newspaper_background.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="NewspaperBackgroundBrush"
                ImageSource="{StaticResource NewspaperBackgroundImage}"
                Stretch="UniformToFill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="DinerBackgroundImage"
                 UriSource="pack://application:,,,/Assets/Images/Backgrounds/diner_background.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="DinerBackgroundBrush"
                ImageSource="{StaticResource DinerBackgroundImage}"
                Stretch="UniformToFill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="SettingsBackgroundImage"
                 UriSource="pack://application:,,,/Assets/Images/Backgrounds/settings_background.png"
                 DecodePixelWidth="1920"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="SettingsBackgroundBrush"
                ImageSource="{StaticResource SettingsBackgroundImage}"
                Stretch="UniformToFill"
                PresentationOptions:Freeze="True"/>

    <!-- Button Images.
         Most of the art is 820-1024 px square for tiles drawn at 88-300 px, so it is decoded 300 wide; the back,
         exit and garage icons are already about 290 px and are loaded as they are -->
    <BitmapImage x:Key="NewGameButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/new_game.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="NewGameButtonBrush"
                ImageSource="{StaticResource NewGameButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="LoadGameButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/load_game.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="LoadGameButtonBrush"
                ImageSource="{StaticResource LoadGameButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="SettingsButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/settings.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="SettingsButtonBrush"
                ImageSource="{StaticResource SettingsButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="ExitButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/exit.png"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="ExitButtonBrush"
                ImageSource="{StaticResource ExitButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="BackButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/back.png"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="BackButtonBrush"
                ImageSource="{StaticResource BackButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="NewspaperButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/newspaper.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="NewspaperButtonBrush"
                ImageSource="{StaticResource NewspaperButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="GarageIconButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/garage_icon.png"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="GarageIconButtonBrush"
                ImageSource="{StaticResource GarageIconButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="HitTheStreetsButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/hit_the_streets.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="HitTheStreetsButtonBrush"
                ImageSource="{StaticResource HitTheStreetsButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="UsedCarsButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/used_cars.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="UsedCarsButtonBrush"
                ImageSource="{StaticResource UsedCarsButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="UsedPartsButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/used_parts.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="UsedPartsButtonBrush"
                ImageSource="{StaticResource UsedPartsButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

    <BitmapImage x:Key="CareerButtonImage"
                 UriSource="pack://application:,,,/Assets/Images/Buttons/career_button.png"
                 DecodePixelWidth="300"
                 CacheOption="OnLoad"
                 PresentationOptions:Freeze="True"/>
    <ImageBrush x:Key="CareerButtonBrush"
                ImageSource="{StaticResource CareerButtonImage}"
                Stretch="Fill"
                PresentationOptions:Freeze="True"/>

</ResourceDictionary>
