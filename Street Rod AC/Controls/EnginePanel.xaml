<UserControl x:Class="Street_Rod_AC.Controls.EnginePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Start the car where it stands and rev it: the key, the tach, the pedal -->
    <Border Background="#CC1A1A1A"
            BorderBrush="#404040"
            BorderThickness="1"
            CornerRadius="5"
            Padding="10,8">
        <Grid DataContext="{Binding Runner, ElementName=Root}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Ignition -->
            <Button x:Name="StartButton"
                    Grid.Column="0"
                    Width="92"
                    Height="46"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Focusable="False"
                    IsEnabled="{Binding CanToggle}"
                    Click="OnStartClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="#2A2A2A"
                                BorderBrush="#606060"
                                BorderThickness="1"
                                CornerRadius="23">
                            <TextBlock x:Name="label"
                                       Text="START"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0A0A0"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                <Setter TargetName="label" Property="Text" Value="STOP"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Tach -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="150">
                <Grid>
                    <TextBlock Text="{Binding RpmDisplay}"
                               FontSize="18"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="RPM"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,3"/>
                </Grid>
                <Grid x:Name="TachTrack" Height="8" Margin="0,3,0,4" ClipToBounds="True">
                    <Border Background="#303030" CornerRadius="2"/>
                    <Rectangle x:Name="RedZone" Fill="#60C02020" HorizontalAlignment="Right"/>
                    <Rectangle x:Name="Needle" Fill="{StaticResource AccentPrimaryBrush}" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding RpmFraction}"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
                <TextBlock x:Name="StatusLine"
                           Text="{Binding StatusText}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Pedal: press and hold, lower is further down -->
            <Border x:Name="Pedal"
                    Grid.Column="2"
                    Width="30"
                    Height="52"
                    Margin="12,0,0,0"
                    Background="#262626"
                    BorderBrush="#606060"
                    BorderThickness="1"
                    CornerRadius="4"
                    Cursor="Hand"
                    ToolTip="Hold to rev: press lower for more. Or hold W / Space."
                    MouseLeftButtonDown="OnPedalDown"
                    MouseMove="OnPedalMove"
                    MouseLeftButtonUp="OnPedalUp"
                    LostMouseCapture="OnPedalLost">
                <Grid ClipToBounds="True">
                    <Rectangle Fill="{StaticResource AccentPrimaryBrush}" Opacity="0.75" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleY="{Binding Pedal}"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle Height="2" Margin="6,2" Fill="#707070"/>
                        <Rectangle Height="2" Margin="6,2" Fill="#707070"/>
                        <Rectangle Height="2" Margin="6,2" Fill="#707070"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
