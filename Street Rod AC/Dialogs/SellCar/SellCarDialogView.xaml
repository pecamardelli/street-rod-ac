<UserControl x:Class="Street_Rod_AC.Dialogs.SellCar.SellCarDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="560">
    <Grid Width="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <StackPanel>
                <TextBlock Text="Sell the Car"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}">
                    <Run Text="{Binding CarName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ValueDisplay, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding HistoryDisplay}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,15">

            <!-- The dealer, or the scrapyard -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DealerTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DealerDetail}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding DealerAmountDisplay}"
                           Foreground="{StaticResource AccentSuccessBrush}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontWeight="SemiBold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Content="{Binding SellButtonText}"
                        Command="{Binding SellToDealerCommand}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Width="110"
                        Height="32"
                        Margin="15,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>

            <Border BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

            <!-- The paper -->
            <TextBlock Text="Put it in the paper"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Nobody buys a wreck out of the paper."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Visibility="{Binding CanAdvertise, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <!-- No ad yet: the asking price -->
            <StackPanel Visibility="{Binding ShowAdForm, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding AdFeeDisplay}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Asking $"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding AskingPriceText, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             FontSize="{StaticResource FontSizeBody}"
                             Padding="5,3"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="3"
                            Content="Place the Ad"
                            Command="{Binding PlaceAdCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Width="110"
                            Height="32"
                            VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding AskingPriceHint}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- In the paper: the ad and the buyer on the phone -->
            <StackPanel Visibility="{Binding HasAd, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding AdStatus}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding OfferDisplay}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="Take It"
                            Command="{Binding AcceptOfferCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Width="90"
                            Height="32"
                            Margin="10,0,0,0"
                            Visibility="{Binding HasOffer, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Grid.Column="2"
                            Content="Turn Down"
                            Command="{Binding DeclineOfferCommand}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Width="90"
                            Height="32"
                            Margin="10,0,0,0"
                            Visibility="{Binding HasOffer, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
                <Button Content="Take the Ad Out"
                        Command="{Binding WithdrawAdCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="140"
                        Height="30"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding Status}"
                       Foreground="{StaticResource GoldBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="{Binding Status, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Money and close -->
        <Border Grid.Row="2"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}">
                    <Run Text="Bankroll: "/><Run Text="{Binding MoneyDisplay, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </TextBlock>
                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="100"
                        Height="35"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
