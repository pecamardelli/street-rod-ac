<UserControl x:Class="Street_Rod_AC.Dialogs.EventEntry.EventEntryDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="550">
    <Border Background="#2A2A2A"
            BorderBrush="#404040"
            BorderThickness="2"
            CornerRadius="10"
            Padding="30"
            MaxWidth="550">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                            Direction="270"
                            ShadowDepth="10"
                            BlurRadius="20"
                            Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="RACE INVITATION"
                          FontSize="28"
                          FontWeight="Bold"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Center"/>
                <Border Background="#404040"
                        CornerRadius="3"
                        Padding="8,4"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                    <TextBlock Text="{Binding RaceTypeDisplay}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Event Info -->
                    <Border Background="#1A1A1A"
                           BorderBrush="#404040"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="{Binding EventName}"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding EventDescription}"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      TextWrapping="Wrap"
                                      Margin="0,8,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Reward: "
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Reward}"
                                          FontSize="12"
                                          FontWeight="Bold"
                                          Foreground="#90EE90"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Opponent Info -->
                    <Border Background="#1A1A1A"
                           BorderBrush="#404040"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="RACING AGAINST"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OpponentName}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#FFD700"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding OpponentNickname, Converter={StaticResource StringToVisibilityConverter}}">
                                    <Run Text="&quot;"/>
                                    <Run Text="{Binding OpponentNickname, Mode=OneWay}"/>
                                    <Run Text="&quot;"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Text="{Binding OpponentCarDisplay}"
                                      FontSize="14"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Car Selection -->
                    <Border Background="#1A1A1A"
                           BorderBrush="#404040"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="SELECT YOUR CAR"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>

                            <ItemsControl ItemsSource="{Binding EligibleCars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CarBorder"
                                                Background="#2A2A2A"
                                                BorderThickness="2"
                                                CornerRadius="5"
                                                Padding="12"
                                                Margin="0,0,0,8"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="OnCarSelected">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#404040"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#606060"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#4A90D9"/>
                                                            <Setter Property="Background" Value="#1A2A3A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Selection indicator -->
                                                <Border Grid.Column="0"
                                                        Width="20" Height="20"
                                                        BorderBrush="#4A90D9"
                                                        BorderThickness="2"
                                                        CornerRadius="10"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                    <Ellipse x:Name="CheckMark"
                                                            Width="10" Height="10"
                                                            Fill="#4A90D9"
                                                            Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                              FontSize="14"
                                                              FontWeight="Bold"
                                                              Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding ConditionText}"
                                                              FontSize="11"
                                                              Foreground="{StaticResource TextSecondaryBrush}"
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Pink Slip Warning -->
                    <Border Background="#3D1F1F"
                           BorderBrush="#FF6B6B"
                           BorderThickness="2"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,10"
                           Visibility="{Binding IsPinkSlip, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="WARNING: PINK SLIP RACE"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="#FF6B6B"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="If you lose, you will forfeit your car to the opponent!"
                                      FontSize="12"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="Enter Race"
                       Command="{Binding ConfirmCommand}"
                       IsEnabled="{Binding CanConfirm}"
                       Style="{StaticResource DialogPrimaryButtonStyle}"
                       Width="150"
                       Margin="0,0,10,0"/>

                <Button Content="Cancel"
                       Command="{Binding CancelCommand}"
                       Style="{StaticResource DialogSecondaryButtonStyle}"
                       Width="100"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
