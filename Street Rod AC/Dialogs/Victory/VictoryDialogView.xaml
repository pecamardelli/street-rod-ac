<UserControl x:Class="Street_Rod_AC.Dialogs.Victory.VictoryDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="520">
    <Grid MinWidth="480">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,18">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="VICTORY!"
                           Foreground="{StaticResource AccentPrimaryBrush}"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding VictoryName}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- What was won, and the career that won it -->
        <StackPanel Grid.Row="1" Margin="24,18">
            <TextBlock Text="{Binding Description}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Label}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeBody}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Footnote}"
                       Visibility="{Binding HasFootnote, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0"/>

            <TextBlock Text="The save goes on: you can keep racing, and the career screen keeps the win."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <Border Grid.Row="2"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Main Menu"
                        Command="{Binding MainMenuCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="120"
                        Height="35"
                        Margin="0,0,10,0"/>
                <Button Content="Keep Racing"
                        Command="{Binding KeepRacingCommand}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Width="120"
                        Height="35"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
