<UserControl x:Class="Street_Rod_AC.Dialogs.ChallengeSetup.ChallengeSetupDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <Border Background="#2A2A2A"
            BorderBrush="#404040"
            BorderThickness="2"
            CornerRadius="10"
            Padding="30">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                            Direction="270"
                            ShadowDepth="10"
                            BlurRadius="20"
                            Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                      Text="CHALLENGE SETUP"
                      FontSize="28"
                      FontWeight="Bold"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                         VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Opponent Info -->
                    <Border Background="#1A1A1A"
                           BorderBrush="#404040"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="RACING AGAINST"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>

                            <TextBlock FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="{Binding OpponentName, Mode=OneWay}"/>
                                <Run Text=" &quot;" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding OpponentNickname, Mode=OneWay}" Foreground="#FFD700"/>
                                <Run Text="&quot;" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>

                            <TextBlock Text="{Binding OpponentCarDisplay}"
                                      FontSize="14"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Your Car -->
                    <Border Background="#1A1A1A"
                           BorderBrush="#404040"
                           BorderThickness="1"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="YOUR CAR"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding PlayerCarDisplay}"
                                      FontSize="18"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Bet Type -->
                    <TextBlock Text="BET TYPE"
                              FontSize="14"
                              FontWeight="Bold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <RadioButton Content="Cash Wager"
                                   IsChecked="{Binding IsCashBet}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,30,0">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="20" Height="20"
                                                           BorderBrush="{StaticResource AccentPrimaryBrush}"
                                                           BorderThickness="2"
                                                           CornerRadius="10"
                                                           Margin="0,0,10,0">
                                                        <Ellipse x:Name="CheckMark"
                                                                Width="10" Height="10"
                                                                Fill="{StaticResource AccentPrimaryBrush}"
                                                                Visibility="Collapsed"/>
                                                    </Border>
                                                    <ContentPresenter/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <RadioButton Content="Pink Slips"
                                   IsChecked="{Binding IsPinkSlipBet}"
                                   FontSize="16"
                                   Foreground="#FF6B6B">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="20" Height="20"
                                                           BorderBrush="#FF6B6B"
                                                           BorderThickness="2"
                                                           CornerRadius="10"
                                                           Margin="0,0,10,0">
                                                        <Ellipse x:Name="CheckMark"
                                                                Width="10" Height="10"
                                                                Fill="#FF6B6B"
                                                                Visibility="Collapsed"/>
                                                    </Border>
                                                    <ContentPresenter/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>

                    <!-- Wager Amount (only visible for cash bets) -->
                    <StackPanel Visibility="{Binding IsCashBetEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="WAGER AMOUNT"
                                  FontSize="14"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding WagerAmountDisplay}"
                                  FontSize="24"
                                  FontWeight="Bold"
                                  Foreground="#90EE90"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10"/>

                        <Slider Value="{Binding WagerAmount}"
                               Minimum="{Binding MinWager}"
                               Maximum="{Binding MaxWager}"
                               TickFrequency="100"
                               IsSnapToTickEnabled="True"
                               Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Min: "
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MinWager, StringFormat='${0:N0}'}"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,20,0"/>
                            <TextBlock Text="Max: "
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MaxWager, StringFormat='${0:N0}'}"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Pink Slip Warning -->
                    <Border Background="#3D1F1F"
                           BorderBrush="#FF6B6B"
                           BorderThickness="2"
                           CornerRadius="5"
                           Padding="15"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsPinkSlipBet, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠ WARNING: PINK SLIP RACE"
                                      FontSize="14"
                                      FontWeight="Bold"
                                      Foreground="#FF6B6B"
                                      Margin="0,0,0,10"/>
                            <TextBlock Text="Loser hands over their car. This is a high-stakes race!"
                                      FontSize="12"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Track -->
                    <TextBlock Text="TRACK"
                              FontSize="14"
                              FontWeight="Bold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,20,0,10"/>

                    <TextBlock Text="{Binding SelectedTrack}"
                              FontSize="16"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Content="Send Challenge"
                       Command="{Binding ConfirmCommand}"
                       Style="{StaticResource DialogPrimaryButtonStyle}"
                       Width="180"
                       Margin="0,0,10,0"/>

                <Button Content="Cancel"
                       Command="{Binding CancelCommand}"
                       Style="{StaticResource DialogSecondaryButtonStyle}"
                       Width="120"
                       Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
