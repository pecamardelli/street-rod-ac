<UserControl x:Class="Street_Rod_AC.Dialogs.Timeslip.TimeslipDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="420">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <TextBlock Text="Timeslip"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- The slip: a strip of paper, both lanes side by side -->
        <Border Grid.Row="1" Padding="20">
            <Border Background="{StaticResource CreamBrush}"
                    Padding="18,14"
                    HorizontalAlignment="Center"
                    MinWidth="320">
                <StackPanel TextElement.FontFamily="Consolas"
                            TextElement.Foreground="Black"
                            TextElement.FontSize="{StaticResource FontSizeBody}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding PlayerName}" FontWeight="Bold" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding OpponentName}" FontWeight="Bold" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Player}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Opponent}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Border>

        <!-- Button -->
        <Border Grid.Row="2"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <Button Content="OK"
                    Command="{Binding OkCommand}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Width="100"
                    Height="35"
                    HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>
