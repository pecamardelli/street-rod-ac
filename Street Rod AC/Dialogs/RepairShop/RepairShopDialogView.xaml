<UserControl x:Class="Street_Rod_AC.Dialogs.RepairShop.RepairShopDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="600">
    <Grid Width="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <Border Grid.Row="0"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,15">
            <StackPanel>
                <TextBlock Text="Repairs"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeHeading}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CarName}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}"/>
            </StackPanel>
        </Border>

        <!-- Jobs -->
        <StackPanel Grid.Row="1" Margin="20,15">
            <TextBlock Text="{Binding Status}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Jobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderDarkBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CostDisplay}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeDisplay}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="3"
                                            Content="Repair"
                                            Command="{Binding Command}"
                                            Style="{StaticResource DialogPrimaryButtonStyle}"
                                            Width="90"
                                            Height="32"
                                            Margin="15,0,0,0"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Money and close -->
        <Border Grid.Row="2"
                Background="{StaticResource BgDarkBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,15">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeBody}">
                    <Run Text="Bankroll: "/><Run Text="{Binding MoneyDisplay, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </TextBlock>
                <Button Content="Close"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Width="100"
                        Height="35"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
