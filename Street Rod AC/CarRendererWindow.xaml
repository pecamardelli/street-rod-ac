<Window x:Class="Street_Rod_AC.CarRendererWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Car Viewer" Height="1080" Width="1920"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Render Host -->
        <WindowsFormsHost Grid.Row="0" x:Name="RenderHost" Margin="0"/>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Camera Distance:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Slider x:Name="ZoomSlider"
                    Width="150"
                    Minimum="2"
                    Maximum="20"
                    Value="5"
                    VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged"/>

            <CheckBox x:Name="AutoRotateCheck"
                      Content="Auto Rotate"
                      Margin="20,0,0,0"
                      VerticalAlignment="Center"
                      Checked="AutoRotateCheck_Changed"
                      Unchecked="AutoRotateCheck_Changed"/>
        </StackPanel>
    </Grid>
</Window>
